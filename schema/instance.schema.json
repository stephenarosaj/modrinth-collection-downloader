{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Stephen-Rosa/modrinth-collection-downloader/schema/instance.schema.json",
  "title": "Instance",
  "description": "Modrinth Collection Downloader Instance schema (v1). Derived status is never serialized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version identifier. Must be 1."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "target", "createdAt"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collectionId", "url"],
          "properties": {
            "collectionId": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gameVersion", "platform", "releasePreference"],
          "properties": {
            "gameVersion": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "releasePreference": {
              "type": "string",
              "enum": ["stable", "newest"]
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "$defs": {
    "EnvironmentId": {
      "type": "string",
      "enum": ["client", "server"]
    },
    "Support": {
      "type": "string",
      "enum": ["required", "optional", "unsupported", "unknown"]
    },
    "ProjectType": {
      "type": "string",
      "enum": ["mod", "plugin", "datapack", "resourcepack", "shader", "modpack"]
    },
    "VersionType": {
      "type": "string",
      "enum": ["release", "beta", "alpha"]
    },
    "Resolution": {
      "type": "string",
      "enum": ["pinned", "latest-compatible", "game-version-fallback", "user", "none"]
    },
    "FileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "size", "sha1", "sha512"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha1": { "type": "string" },
        "sha512": { "type": "string" }
      }
    },
    "DependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "type"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["required", "optional", "incompatible", "embedded"]
        }
      }
    },
    "VersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionNumber",
        "versionType",
        "publishedAt",
        "gameVersions",
        "platforms",
        "file",
        "dependencies"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "versionNumber": { "type": "string", "minLength": 1 },
        "versionType": { "$ref": "#/$defs/VersionType" },
        "publishedAt": { "type": "string" },
        "gameVersions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "file": { "$ref": "#/$defs/FileRef" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/DependencyRef" }
        }
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "source"],
      "properties": {
        "on": { "type": "boolean" },
        "source": {
          "type": "string",
          "enum": ["none", "user", "auto"]
        }
      }
    },
    "EnvironmentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "candidates",
        "version",
        "resolution",
        "dependencies",
        "requiredBy",
        "selection"
      ],
      "properties": {
        "support": { "$ref": "#/$defs/Support" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/VersionRef" }
        },
        "version": {
          "oneOf": [
            { "$ref": "#/$defs/VersionRef" },
            { "type": "null" }
          ]
        },
        "resolution": { "$ref": "#/$defs/Resolution" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredBy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "selection": { "$ref": "#/$defs/Selection" }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "origin", "environments"],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "slug", "title", "type", "modrinthUrl"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "type": { "$ref": "#/$defs/ProjectType" },
            "modrinthUrl": { "type": "string", "minLength": 1 }
          }
        },
        "origin": {
          "type": "string",
          "enum": ["collection", "dependency"]
        },
        "environments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["client", "server"],
          "properties": {
            "client": { "$ref": "#/$defs/EnvironmentState" },
            "server": { "$ref": "#/$defs/EnvironmentState" }
          }
        }
      }
    }
  }
}
